# Konfigirasyon serveur
PORT=3000
NODE_ENV=development

# Koneksyon PostgreSQL an lokal
DB_HOST=localhost
DB_PORT=5432
DB_NAME=entreprise_info
DB_USER=postgres
DB_PASSWORD=

# Sou yon tè deplwaman, ranplase senk varyab anwo yo pa yon sèl chèn.
# Lè DATABASE_URL prezan, se li ki genyen epi SSL aktive otomatikman.
# DATABASE_URL=postgresql://itilizatè:modpas@lot.neon.tech/baz?sslmode=require

# Sekrè sesyon (chanje l pou yon chèn owaza long)
SESSION_SECRET=

# Kle Stripe (mòd test)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
